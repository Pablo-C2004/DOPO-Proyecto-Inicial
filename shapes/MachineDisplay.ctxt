comment0.target=MachineDisplay
comment0.text=\r\n\ Representacion\ visual\ de\ la\ maquina\ tragamonedas,\ construida\r\n\ reutilizando\ las\ clases\ del\ paquete\ shapes\:\r\n
comment1.params=
